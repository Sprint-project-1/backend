# Docker PostgreSQL 18: local port 5435 (container port 5432).
# The backend uses this single database URL for both Prisma and application queries.
DATABASE_URL="postgresql://cinefund:cinefund_local@127.0.0.1:5435/cinefund?schema=public"

# Fill in only ONE of these (never commit the real secret):
TMDB_API_KEY=""
TMDB_API_TOKEN=""

CORS_ORIGINS="http://localhost:5173"
