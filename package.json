{
  "name": "cinefund-db",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "db:up": "node prisma/start-db.js",
    "db:down": "docker compose down",
    "db:migrate": "node prisma/ensure-funding-database.js && prisma migrate deploy --config prisma/funding.config.js && node prisma/migrate-fundings.js && prisma migrate deploy",
    "db:generate": "prisma generate && prisma generate --config prisma/funding.config.js",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:generate && pnpm db:seed",
    "movies:select": "node src/movies/selectMovies.js",
    "db:seed": "node prisma/seed.js",
    "test": "node --test tests/*.test.js",
    "test:db": "node src/utils/checkDb.js",
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
