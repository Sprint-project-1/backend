{
  "name": "cinefund-db",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:migrations:check": "node scripts/checkMigrations.js",
    "db:generate": "prisma generate",
    "movies:select": "node src/movies/selectMovies.js",
    "db:seed": "node prisma/seed.js",
    "test": "node --test tests/*.test.js",
    "test:db": "node src/utils/checkDb.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
